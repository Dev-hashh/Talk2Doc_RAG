# Copy this file to .env and fill in the values for your environment.

# Database
# Use your Supabase/Postgres connection string.
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Auth
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_MINUTES=10080

# Index storage inside Docker is mounted from ./indexes.
INDEX_DIR=indexes

# LLM provider
USE_GROQ=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# For local non-Docker runs, localhost is fine.
# docker-compose.yml overrides this to host.docker.internal for containers.
OLLAMA_URL=http://localhost:11434/api/generate
MODEL_NAME=deepseek-v3.1:671b-cloud
EMBEDDING_MODEL=BAAI/bge-small-en
